{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "argrune",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
